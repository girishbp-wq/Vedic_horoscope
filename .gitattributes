# Normalise line endings so OneDrive/Windows CRLF no longer shows every file as changed.
* text=auto eol=lf

# Explicit text types (served by GitHub Pages)
*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

# Binary assets — never touch
*.xlsx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
